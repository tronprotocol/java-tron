# Multi-stage build for java-tron from local source
# Stage 1: Build stage with full JDK and build tools
FROM eclipse-temurin:8-jdk-jammy AS builder

ENV BUILD_DIR="/build"

WORKDIR ${BUILD_DIR}

# Copy local source code
COPY . ${BUILD_DIR}/

# Build java-tron from local source
RUN set -o errexit -o nounset \
    && echo "Building java-tron from local source..." \
    && chmod +x ./gradlew \
    && ./gradlew clean build -x test --no-daemon --no-build-cache -Dorg.gradle.dependency.verification=lenient \
    && echo "Build completed successfully"

# Extract the distribution using jar (no zip bomb check)
RUN cd ${BUILD_DIR}/build/distributions \
    && jar xf java-tron-*.zip \
    && DIR=$(ls -d java-tron-* | head -n 1) \
    && mv "$DIR" /java-tron-dist


# Stage 2: Final runtime image with only JRE
FROM eclipse-temurin:8-jre-jammy

LABEL maintainer="TRON Foundation"
LABEL description="TRON Full Node - Local Build"

ENV BASE_DIR="/java-tron"
ENV BUILD_DIR="/build"
ENV JAVA_OPTS="-Xmx6g -XX:+UseConcMarkSweepGC"

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p ${BASE_DIR}

# Copy the built application from builder stage
COPY --from=builder /java-tron-dist ${BASE_DIR}

# Download mainnet config
RUN mkdir -p ${BASE_DIR}/config \
    && wget -O ${BASE_DIR}/config/main_net_config.conf \
    https://raw.githubusercontent.com/tronprotocol/tron-deployment/master/main_net_config.conf

# Copy docker entrypoint from builder stage
COPY --from=builder ${BUILD_DIR}/docker/docker-entrypoint.sh ${BASE_DIR}/bin/
RUN chmod +x ${BASE_DIR}/bin/docker-entrypoint.sh

WORKDIR ${BASE_DIR}

ENTRYPOINT ["./bin/docker-entrypoint.sh"]
